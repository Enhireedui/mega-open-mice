# ---------------------------------------------------------------------------
# SAIN MOTORS — MEGA OPEN MIC
# Copy this file to `.env.local` and fill in the values. Never commit .env.local
# ---------------------------------------------------------------------------

# Google Apps Script Web App URL — the /exec URL you get after deploying
# docs/apps-script.gs from the MEGA OPEN MIC registrations spreadsheet:
# https://docs.google.com/spreadsheets/d/1J_fff-66k5Q027YpQFu0PlYKUGeYeW90GyRjnvR-T7c/edit
#
# This must be a NEW deployment against that sheet. Do not paste the MEGA TEST
# DRIVE 5 webhook here: it writes to a different spreadsheet, expects a
# time-slot field, and is still serving the live test-drive page.
#
# Treat it as a SECRET: it accepts writes, so anyone holding it can add rows to
# the sheet. Never paste the real value into this file — this one is committed.
# It belongs in .env.local locally, and in the host's environment variables in
# production. Never prefixed with NEXT_PUBLIC_.
#
# Shape: https://script.google.com/macros/s/<deployment-id>/exec
GOOGLE_SHEETS_WEBHOOK_URL=

# Canonical site origin, used for metadata / Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=https://megaopenmic.sainmotors.mn
